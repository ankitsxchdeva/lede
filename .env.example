# Copy to .env and edit. Every knob has a code default; nothing here is
# required. The only files lede needs are feeds.yaml and this file.

# How often to rebuild the digest, in seconds
POLL_INTERVAL_SECONDS=1800

# "Today" for the digest: only items published since midnight in this
# timezone make the board. IANA name, e.g. America/Chicago, Europe/Berlin.
DIGEST_TZ=UTC

# Which origin may fetch the API when the frontend is hosted elsewhere
# (GitHub Pages etc.). Same-origin container installs can leave this.
ALLOW_ORIGIN=*

# Be a polite bot: a contact URL helps feed owners reach you
USER_AGENT=lede/1.0 (+https://example.com/lede)

# Timezone for log timestamps (defaults to UTC)
#TZ=UTC

# Optional: route sources marked `paywall: true` through a 13ft proxy
#PAYWALL_PROXY=http://13ft:5000

# --- LLM summaries (optional, local Ollama) ---
# Off by default: items show their feed's own truncated blurb instead.
# With the compose `llm` profile, the defaults below just work. Any
# reachable Ollama will do — point OLLAMA_URL at it and skip the profile.
SUMMARY_ENABLED=0
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
# Per-request timeout (seconds) for a single Ollama call
OLLAMA_TIMEOUT=90
# How long Ollama keeps the model resident after a call
OLLAMA_KEEP_ALIVE=10m
# Cap on model calls per build cycle; a backlog of new items spills into
# later cycles instead of blowing the build window
SUMMARY_MAX_PER_CYCLE=50
# Consecutive failures before the breaker trips and the rest of the cycle
# falls back to feed blurbs
SUMMARY_BREAKER_THRESHOLD=3
